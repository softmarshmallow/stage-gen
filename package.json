{
  "name": "stage-gen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "components/*",
    "stage-gen",
    "web"
  ],
  "scripts": {
    "stage-gen": "bun run stage-gen/src/cli.ts",
    "check:stage-gen": "bun --filter @stage-gen/stage-gen check",
    "test:stage-gen": "bun --filter @stage-gen/stage-gen test",
    "web": "bun --filter @stage-gen/web dev",
    "web:build": "bun --filter @stage-gen/web build"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.42.0",
    "typescript": "^5.6.3"
  }
}
