# Required credentials (leave blank in source control).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# Optional provider endpoints.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAL_BASE_URL=https://fal.run
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Default capability models.
STAGE_GEN_OPENAI_IMAGE_MODEL=gpt-image-2
# Tier 4 GPT Image 2 allowance. Override to match the active OpenAI project.
STAGE_GEN_OPENAI_IMAGE_IPM=150
IMAGE_MODEL=openai/gpt-image-2
TEXT_MODEL=openai/gpt-5.6-sol
MUSIC_MODEL=google/lyria-3-pro-preview
BACKGROUND_REMOVAL_MODEL=fal-ai/birefnet/v2

# Default transparency strategy and generated artifact root.
TRANSPARENCY_MODE=native
OUT_DIR=out

# Optional stage-gen-prefixed overrides. Leave blank to inherit the defaults above.
STAGE_GEN_OUT_DIR=
STAGE_GEN_GAME_LIBRARY_ROOT=
STAGE_GEN_IMAGE_MODEL=
STAGE_GEN_TEXT_MODEL=
STAGE_GEN_MUSIC_MODEL=
STAGE_GEN_BACKGROUND_REMOVAL_MODEL=

# Stage and per-capability timeout defaults in milliseconds.
STAGE_GEN_STAGE_TIMEOUT_MS=1800000
STAGE_GEN_CAPABILITY_TIMEOUT_MS=600000

# Set to 1 to bypass otherwise valid recipe cache entries.
STAGE_GEN_FORCE=0

# Explicit opt-in for provider-backed pytest smoke tests.
STAGE_GEN_RUN_LIVE=0

# Optional web server launcher override: uv, stage-gen, stage-gen-py, or an
# absolute path whose basename is one of those values.
STAGE_GEN_EXECUTABLE=
