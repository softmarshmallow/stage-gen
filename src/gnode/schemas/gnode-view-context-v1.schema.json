{
 "$defs": {
  "file": {
   "properties": {
    "digest": {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    },
    "facts": {
     "type": "object"
    },
    "key": {
     "type": [
      "string",
      "null"
     ]
    },
    "kind": {
     "type": "string"
    },
    "ref": {
     "pattern": "^views/files/[0-9a-f]{64}(\\.[a-z0-9]+)?$",
     "type": "string"
    },
    "size": {
     "minimum": 0,
     "type": "integer"
    },
    "url": {
     "type": "string"
    },
    "value": {}
   },
   "required": [
    "kind",
    "digest",
    "ref"
   ],
   "type": "object"
  }
 },
 "$id": "urn:gnode:schema:gnode-view-context-v1",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "else": {
  "required": [
   "steps"
  ]
 },
 "if": {
  "properties": {
   "scope": {
    "const": "node"
   }
  }
 },
 "properties": {
  "facts": {
   "type": "object"
  },
  "inputs": {
   "type": "object"
  },
  "kind": {
   "const": "gnode-view-context-v1"
  },
  "node_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "outputs": {
   "type": "object"
  },
  "run": {
   "properties": {
    "cost_usd": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "id": {
     "type": "string"
    },
    "status": {
     "type": "string"
    },
    "workflow": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "type": "object"
  },
  "scope": {
   "enum": [
    "node",
    "workflow"
   ]
  },
  "step": {
   "properties": {
    "cost_usd": {
     "minimum": 0,
     "type": "number"
    },
    "path": {
     "type": "string"
    },
    "status": {
     "type": "string"
    },
    "step": {
     "type": [
      "string",
      "null"
     ]
    },
    "take": {
     "minimum": 1,
     "type": "integer"
    },
    "title": {
     "type": "string"
    },
    "with": {
     "type": "object"
    }
   },
   "required": [
    "path",
    "title",
    "status"
   ],
   "type": "object"
  },
  "steps": {
   "type": "object"
  },
  "template": {
   "pattern": "^views/[0-9a-f]{64}\\.html$",
   "type": "string"
  }
 },
 "required": [
  "kind",
  "scope",
  "template",
  "outputs",
  "run"
 ],
 "then": {
  "required": [
   "node_id",
   "step",
   "inputs"
  ]
 },
 "title": "gnode view context: what a step's or a workflow's view reads from `context()`",
 "type": "object"
}
