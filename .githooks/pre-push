#!/usr/bin/env bash
# The fast half of the offline gate, run before anything leaves this machine.
# About ten seconds: formatting, lint, the web suite, and the contract tests -
# which is the half that would have caught every red-gate commit so far.
# Install once with: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
uv run ruff format --check .
uv run ruff check .
(cd web && bun test)
uv run pytest -m "not live" tests/contract -q
