#!/usr/bin/env bash
# The fast half of the offline gate, run against what is actually being pushed.
#
# It used to run in the working tree, which is a proxy for the commits and not
# the same thing. The proxy holds for one developer with a clean checkout and
# fails in both directions otherwise. The loud direction: a second agent working
# in `src/` made three of the four steps fail on files that were not in the push
# at all, so a green commit could not leave the machine. The quiet direction is
# worse — a commit that is red on a fresh clone passes this hook whenever the
# fix is sitting uncommitted in the tree, which is exactly the failure the hook
# exists to prevent. It found one on its first run: the docs gate was passing
# only because somebody's gitignored concept-studio workspace happened to be on
# disk.
#
# So: check out each pushed commit into a throwaway worktree and gate that. The
# working tree is never read, never stashed, and never touched — which also
# makes the hook safe to run while somebody else is editing it.
#
# About twenty seconds, most of it the contract suite. Install once with:
#   git config core.hooksPath .githooks
set -euo pipefail

repository="$(git rev-parse --show-toplevel)"
cd "$repository"

ZERO="0000000000000000000000000000000000000000"

# Status is captured rather than inherited. The first cut of this used `set -e`
# with a RETURN trap and got both halves wrong: a failing gate exited 0, so a red
# ref would have been pushed, and the throwaway worktree was left registered
# because `set -e` aborts before a RETURN trap runs. Neither is visible unless
# the hook is tested against a commit that is actually red, which is the one test
# a gate has to pass.
cleanup() {
	local scratch="$1"
	[ -n "$scratch" ] || return 0
	git worktree remove --force "$scratch" >/dev/null 2>&1 || true
	rm -rf "$scratch"
	git worktree prune >/dev/null 2>&1 || true
}

gate() {
	local sha="$1" ref="$2" scratch status=0
	scratch="$(mktemp -d "${TMPDIR:-/tmp}/stage-gen-prepush.XXXXXX")"
	# shellcheck disable=SC2064
	trap "cleanup '$scratch'" EXIT

	echo "pre-push: gating ${ref} at ${sha:0:12} in a clean worktree"
	if ! git worktree add -q --detach "$scratch" "$sha"; then
		cleanup "$scratch"
		trap - EXIT
		echo "pre-push: could not check out ${sha:0:12}" >&2
		return 1
	fi
	(
		cd "$scratch"
		uv sync --all-groups --frozen --quiet
		uv run --all-groups ruff format --check .
		uv run --all-groups ruff check .
		(cd web && bun install --frozen-lockfile --silent && bun test)
		uv run --all-groups pytest -m "not live" tests/contract -q
	) || status=$?
	cleanup "$scratch"
	trap - EXIT
	return "$status"
}

pushed=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	# A branch deletion pushes no content, so there is nothing to gate.
	[ "$local_sha" = "$ZERO" ] && continue
	if ! gate "$local_sha" "${_remote_ref:-HEAD}"; then
		echo "pre-push: ${_remote_ref:-HEAD} is red at ${local_sha:0:12}; nothing pushed" >&2
		exit 1
	fi
	pushed=1
done

# Git gives the refs on stdin. Nothing there means nothing to push, and gating
# HEAD instead would be gating something the push never mentioned.
if [ "$pushed" -eq 0 ]; then
	echo "pre-push: nothing to gate"
fi
