        {
          "kind": "line",
          "speaker": "mari",
          "expression": null,
          "text": "I said the eighth one was turned the wrong way round. That is all I said."
        },
        {
          "kind": "line",
          "speaker": "kenji",
          "expression": null,
          "text": "From where I am sitting you can see it perfectly well."
