      "statements": [
        {
          "kind": "line",
          "speaker": "sayaka",
          "expression": null,
          "text": "Somebody should say something before the soup goes cold."
        },
        {
          "kind": "choice",
          "options": [
            {
              "text": "Let Sayaka give the toast.",
              "target": "toast_given"
            },
            {
              "text": "Say nothing, and watch the card.",
              "target": "toast_skipped"
            }
          ]
        }
