        {
          "kind": "line",
          "speaker": null,
          "expression": null,
          "text": "Five of them are already seated when you come in, and the sixth chair is yours."
        },
        {
          "kind": "show",
          "actor": "mari",
          "expression": "composed",
          "slot": "far_left"
