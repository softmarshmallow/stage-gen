          "zoom": {"type": "number", "min": 1, "max": 1.15, "required": true}
        }
      },
      "to_frame": {
        "type": "object",
        "required": true,
        "properties": {
          "stage": {"type": "string", "required": true},
          "cast": {
            "type": "array",
            "required": true,
            "items": {
              "type": "object",
              "properties": {
                "actor_id": {"type": "string", "required": true},
                "expression": {"type": "string", "required": true},
                "slot": {"type": "string", "enum": ["far_left", "left", "center", "right", "far_right"], "required": true}
              }
            }
          },
          "focus": {"type": "string", "required": true},
          "zoom": {"type": "number", "min": 1, "max": 1.15, "required": true}
        }
