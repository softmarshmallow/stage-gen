# The Last Class of Summer — Larkfield's first scenario.
#
# Every name used here is declared in ../scenario.toml. This file is only the
# part a person writes; digests, rights, and generation briefs live there.


label arrival:
    stage classroom_day
    play summer_room

    "The last bell went twenty minutes ago. The room still smells of chalk and hot dust, and the fans have already been switched off for the season."

    show nao neutral at center

    nao "Everyone's gone home. I wanted to record the room before they lock the building."

    menu:
        "Say nothing, and listen with her.":
            jump listening
        "Ask what she's recording.":
            jump asking


label listening:
    set stayed_quiet

    "So you say nothing. The cicadas fill the gap where the answer would have been."

    nao delighted "Thank you. Most people start talking the second I hold this up."

    jump the_playback


label asking:
    set asked_about_recorder

    you "What is there to record? It's an empty room."

    nao flustered "It's not empty. It's just quiet. Those aren't the same, and I can prove it."

    jump the_playback


label the_playback:
    "She rewinds a little way and holds the recorder flat on the desk between you."

    nao neutral "There. Under the cicadas. It does that every evening at about this time."

    "Something is there. Not a hum, not a voice. Three notes, evenly spaced, and then nothing."

    menu:
        "Tell her you heard it too.":
            jump heard_it
        "Tell her it's the pipes cooling down.":
            jump dismissed


label heard_it:
    set heard_the_signal

    you "Three notes. I heard them."

    nao delighted "You heard it. I've played that to four people and you are the first one who didn't say pipes."

    jump haruki_arrives


label dismissed:
    you "It's the pipes. The building does that when the sun goes off the west wall."

    nao concerned "Maybe. The pipes have very good rhythm, then."

    jump haruki_arrives


label haruki_arrives:
    stage classroom_dusk
    stop summer_room
    play dusk_signal

    "The corridor light clicks on outside. Someone has been standing in the doorway long enough to have heard most of it."

    show haruki neutral at left

    haruki "The pipes don't do that. I've had eleven months to get bored of the pipes."

    menu:
        "Tell him about the three notes." if heard_the_signal:
            jump tell_haruki
        "Ask what he's doing here this late.":
            jump ask_club
        "Say you were just leaving.":
            jump part_ways


label tell_haruki:
    set told_haruki

    you "Three notes, evenly spaced, every evening. She has it on tape."

    haruki flustered "Every evening. You are aware that is the single most annoying thing you could have told me tonight."

    jump the_locked_door


label ask_club:
    you "What keeps you here this late?"

    haruki neutral "Radio club. I am the radio club. Membership peaked at three and then everyone discovered other interests."

    nao delighted "He has a whole room. Under the stairs, with a door and everything."

    jump the_locked_door


label part_ways:
    haruki neutral "Suit yourself. The building locks at seven whether you're in it or not."

    hide haruki
    jump evening_ends


label the_locked_door:
    "The door under the stairs is the kind nobody looks at twice. There is a receiver behind it that has not been switched on since spring."

    haruki concerned "It's locked, before you ask. They took the key off me in April for reasons I still consider unfair."

    menu:
        "Go and ask Ms Toda for it.":
            jump ask_toda
        "Leave it for tonight.":
            jump part_ways


label ask_toda:
    show sayaka neutral at right

    sayaka "The three of you look like a delegation. That is never a good sign at this hour."

    menu:
        "Tell her exactly what's on the tape." if heard_the_signal:
            jump tell_toda
        "Tell her it's for a club project.":
            jump pretext


label tell_toda:
    set keys_borrowed

    you "There are three notes on Nao's recording. Every evening, same time. We want to hear them on something better than a phone speaker."

    sayaka delighted "Well. That is a considerably better reason than the one I was braced for."

    "She unclips the lanyard without looking at it, the way you hand over something you have been waiting to be asked for."

    hide sayaka
    jump the_radio_room


label pretext:
    you "It's for a club project. Nothing complicated."

    sayaka concerned "Then it will keep until Monday, when I can be there for it. Go home, all of you."

    hide sayaka
    hide haruki
    jump evening_ends


label the_radio_room:
    stage radio_room
    stop dusk_signal
    play under_the_stairs

    "The room under the stairs is smaller than a door suggests. Dust on the console, a wall of grey panels, and one dial still turned to where somebody left it."

    haruki delighted "Nobody has touched this since April. Give me a minute."

    nao neutral "Take two. It's not going anywhere before seven."

    if keys_borrowed and told_haruki:
        jump ending_broadcast

    if keys_borrowed:
        jump ending_talked

    jump evening_ends


label evening_ends:
    stage classroom_dusk
    stop under_the_stairs
    play dusk_signal

    "The fluorescent tubes tick overhead. Somewhere below, a door closes, and the building settles the way it does every evening at about this time."

    if stayed_quiet and not asked_about_recorder:
        jump ending_listened

    jump ending_locked_out


# --------------------------------------------------------------- the endings


label ending_broadcast:
    "The receiver warms up the way old things do, slowly and then all at once."

    haruki delighted "There. Three notes. On a real antenna, from something that is definitely not a pipe."

    nao delighted "Say that again with the recorder running."

    hide nao
    hide haruki
    stop under_the_stairs
    end broadcast


label ending_talked:
    haruki concerned "Nothing. Forty minutes of nothing, and it's ten to seven."

    nao neutral "Then we know where it isn't. That's not the same as nothing."

    hide nao
    hide haruki
    stop under_the_stairs
    end talked


label ending_listened:
    show nao delighted at center

    nao delighted "You heard it too. I could tell. You went still."

    "She stops the recorder without looking at it, the way you stop a clock you already trust."

    hide nao
    stop dusk_signal
    end listened


label ending_locked_out:
    show nao concerned at center

    nao concerned "You'll hear it on the playback. Probably. It's under everything else we said."

    "She winds the cable around the recorder twice, and does not offer to play it back."

    hide nao
    stop dusk_signal
    end locked_out
