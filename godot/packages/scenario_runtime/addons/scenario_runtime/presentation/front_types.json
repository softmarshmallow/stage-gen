  "front_eye": {
    "version": 1,
    "parameters": {
      "mode": {
        "type": "string",
        "default": "eye_opening",
        "enum": [
          "eye_opening",
          "eye_closing",
          "blink",
          "waking_opening"
        ]
      },
      "settings": {
        "type": "object",
        "properties": {
          "opening_seconds": {
            "type": "number",
            "min": 0.1,
            "max": 8
          },
          "closing_seconds": {
            "type": "number",
            "min": 0.1,
            "max": 4
          },
          "closed_hold_seconds": {
            "type": "number",
            "min": 0,
            "max": 2
          },
          "peek_seconds": {
            "type": "number",
            "min": 0.05,
            "max": 2
          },
          "peek_openness": {
            "type": "number",
            "min": 0.05,
            "max": 1
          }
        },
        "default": {}
      }
    },
    "reconstructable": true
  },
  "front_establish": {
    "version": 1,
