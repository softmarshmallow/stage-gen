      },
      "target": {
        "type": "string",
        "default": ""
      },
      "settings": {
        "type": "object",
        "properties": {
          "duration_seconds": {
            "type": "number",
            "min": 0,
            "max": 5
          },
          "curve": {
            "type": "string",
            "enum": [
              "linear",
              "ease_in_out",
              "spring"
            ]
          },
          "frequency": {
            "type": "number"
          },
          "damping_ratio": {
            "type": "number"
          },
          "stop_distance": {
            "type": "number"
          }
        },
        "default": {}
      }
    },
    "reconstructable": true
