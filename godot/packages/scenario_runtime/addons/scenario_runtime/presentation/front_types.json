  "front_burst": {
    "version": 1,
    "parameters": {
      "actor": {
        "type": "string",
        "default": ""
      },
      "sprites": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "origin_uv": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "default": [
          0.5,
          0.25
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "min": 1,
            "max": 256
          },
          "duration": {
            "type": "number",
            "min": 0.05,
            "max": 30
          },
          "spread_degrees": {
            "type": "number",
            "min": 0,
            "max": 360
          },
          "angle_degrees": {
            "type": "number",
            "min": -360,
            "max": 360
          },
          "start_radius": {
            "type": "number",
            "min": 0,
            "max": 2048
          },
          "distance": {
            "type": "number",
            "min": 0,
            "max": 4096
          },
          "sprite_size": {
            "type": "number",
            "min": 1,
            "max": 512
          },
          "pop_seconds": {
            "type": "number",
            "min": 0.01,
            "max": 10
          },
          "fade_start": {
            "type": "number",
            "min": 0,
            "max": 1
          },
          "spin_degrees": {
            "type": "number",
            "min": -1440,
            "max": 1440
          },
          "seed": {
            "type": "number",
            "min": 0,
            "max": 65535
          }
        },
        "default": {}
      }
    },
    "reconstructable": true
  }
