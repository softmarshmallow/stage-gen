{
  "front_view": {
    "version": 1,
    "parameters": {
      "speaker": {
        "type": "string",
        "default": ""
      },
      "camera_mode": {
        "type": "string",
        "default": "dialogue",
        "enum": [
          "dialogue",
          "walking",
          "establish",
          "detail"
        ]
      },
      "portrait_mode": {
        "type": "string",
        "default": "none",
        "enum": [
          "none",
          "detail",
          "contact",
          "eye"
        ]
      },
      "cast_visible": {
        "type": "boolean",
        "default": true
      },
      "halo": {
        "type": "boolean",
        "default": false
      },
      "eye_mask": {
        "type": "boolean",
        "default": false
      },
      "flare": {
        "type": "boolean",
        "default": false
      },
      "heat": {
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 1
      },
      "barrier": {
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 1
      },
      "scene_corruption": {
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 1
      },
      "corruption": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string"
          },
          "area": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "strength": {
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 1
          }
        },
        "default": {}
      },
      "field_envelope": {
        "type": "string",
        "default": "hold",
        "enum": [
          "hold",
          "fade_in",
          "fade_out"
        ]
      },
      "duration_seconds": {
        "type": "number",
        "default": 1.6,
        "min": 0
      }
    },
    "reconstructable": true
  },
  "front_reset": {
    "version": 1,
    "parameters": {
      "controllers": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "eye",
            "drift",
            "establish",
            "walking",
            "shake",
            "burst",
            "pan",
            "camera",
            "marks",
            "reactions"
          ]
        },
        "default": []
      }
    },
    "reconstructable": true
  },
  "front_background": {
    "version": 1,
    "parameters": {
